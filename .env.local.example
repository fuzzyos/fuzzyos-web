# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WorkOS Configuration
# Get your API key and Client ID from https://dashboard.workos.com
WORKOS_API_KEY=sk_example_123456789
WORKOS_CLIENT_ID=client_123456789

# Redirect URI for OAuth callback (must match WorkOS dashboard configuration)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/authorization-code/callback
WORKOS_REDIRECT_URI=http://localhost:3000/authorization-code/callback

# Cookie encryption password (generate with: openssl rand -base64 32)
# Must be at least 32 characters long
WORKOS_COOKIE_PASSWORD=generate-a-secure-password-here-min-32-chars
